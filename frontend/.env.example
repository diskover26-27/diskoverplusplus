# Django REST API root. Note the "/diskover_api" suffix.
VITE_APP_API_URL=http://127.0.0.1:8000/diskover_api

# Where Django serves images/assets (markers, location photos).
VITE_APP_STATIC_URL=http://127.0.0.1:8000/static

# OSRM routing service used by the "Directions" tab.
# Optional: locations/descriptions work without it. Point this at your OSRM host.
VITE_BASE_URL=http://127.0.0.1:5001
